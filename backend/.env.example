# Environment Variables Template
# Copy this file to .env and fill in your actual values

# JWT Configuration
SECRET_KEY=change-this-in-production-use-at-least-32-characters
ALGORITHM=HS256

# Email Configuration (Gmail)
EMAIL=barberadmin1@gmail.com
PASS_APP=your-16-digit-app-password

# Database (optional, adjust as needed)
DATABASE_URL=sqlite:///./test.db

# CORS Configuration
# For local development
CORS_ORIGINS=http://localhost:5173
# For production (comma-separated if multiple origins)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
